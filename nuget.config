<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The machine-level config carries a private work feed (packagesinternal.struct.dk)
       that 403s outside that environment and fails every restore. Clear inherited
       sources — this project only needs nuget.org. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
