# /opt/bandroom/.env on the server. deploy.sh generates the secrets on first
# run; only the smtp block needs a human (the resend api key).
TAG=latest
WEB_DOMAIN=bandroom.io
API_DOMAIN=api.bandroom.io
FILES_DOMAIN=files.bandroom.io

DB_PASSWORD=
JWT_SIGNING_KEY=
MINIO_ROOT_USER=bandroom
MINIO_ROOT_PASSWORD=

# Resend over plain smtp. Leave SMTP_HOST empty and mail is logged instead of sent.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
EMAIL_FROM=no-reply@bandroom.io

# Dogfood: every band is pro until billing opens up.
EVERY_BAND_PRO=true
